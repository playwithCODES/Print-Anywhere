{
  "name": "print-anywhere-sender",
  "version": "1.0.0",
  "description": "Print Anywhere Client Tray App for remote Ctrl+P printing",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dist": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && electron-builder --win nsis"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.printanywhere.sender",
    "productName": "print-sender",
    "files": [
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "virtual-printer-bin",
        "to": "virtual-printer-bin"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh"
    }
  }
}